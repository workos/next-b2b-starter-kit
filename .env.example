# Use your own WorkOS development environment and Stripe test-mode account.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Generate a random secret of at least 32 characters; never commit the real value.
WORKOS_COOKIE_PASSWORD=
STRIPE_API_KEY=

# Local application URLs; these values are compiled into a Next.js build.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
